{
	servers {
		trusted_proxies static {$BALSAVE_TRUSTED_PROXY_CIDRS}
		trusted_proxies_strict
	}
}

:8080 {
	encode zstd gzip

	@internal path /_internal /_internal/*
	handle @internal {
		respond 404
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up X-Balsave-Client-IP {client_ip}
		}
	}
}
