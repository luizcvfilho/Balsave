    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "better-auth": "1.7.27",
    "kysely": "0.29.9",
    "next": "^16.4.6",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.64.1",
